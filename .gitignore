migrate_working_dir/
untranslated-messages.txt
analyze_output.txt
obfuscate

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/
.metadata

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Workspace Dart/Flutter related
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
**/doc/api/

# FVM

# Environment / Secrets
Environment.xcconfig
env/
*.env

# Signing material and Firebase client configs, at any depth. The nested
# apps/mobile/android/.gitignore and ios/.gitignore say the same; these
# repeat it so a new app, or a keystore dropped anywhere else, is covered too.
*.jks
*.keystore
key*.properties
**/google-services.json
**/GoogleService-Info.plist
# The one deliberate exception: the public dev key, tracked so a fresh clone
# builds the dev flavor (docs/en/operations/02_fastlane_release.md section 4).
!apps/mobile/android/keystore-dev.jks
!apps/mobile/android/key-dev.properties

# Lock files — except the workspace's own. A Pub workspace has exactly one
# pubspec.lock, at the root, and for an app it belongs in git: without it
# every clone and every CI run resolves whatever versions are newest that day.
*.lock
!/pubspec.lock
# Bundler's lockfiles (root and apps/mobile/) pin fastlane, cocoapods and the
# fastlane plugins the same way; commit each after the first `bundle install`.
!Gemfile.lock
.kiro

# Workspace Tools & Reports
code_review_reports/

# FVM Version Cache
.fvm/
