{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (Dev)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file",
        "env.dev"
      ]
    },
    {
      "name": "App (Staging)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "staging",
        "--dart-define-from-file",
        "env.stg"
      ]
    },
    {
      "name": "App (Prod)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/mobile",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "prod",
        "--dart-define-from-file",
        "env.prod"
      ]
    },
    {
      "name": "Admin (Web, Dev)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/admin",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file",
        "env.dev",
        "--dart-define",
        "APP_FLAVOR=dev"
      ]
    },
    {
      "name": "Admin (Desktop, Dev)",
      "request": "launch",
      "type": "dart",
      "cwd": "apps/admin",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file",
        "env.dev"
      ]
    }
  ]
}
