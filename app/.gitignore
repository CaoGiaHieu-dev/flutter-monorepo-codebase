# App-specific Dart/Flutter ignore
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Android Studio / Android specific
/android/app/debug/
/android/app/profile/
/android/app/release/

# Xcode specific
/ios/Flutter/.last_build_id

# Generated code
*.g.dart
*.freezed.dart
*.gr.dart
*.config.dart
*.module.dart
**/gen/**
**/generated/**

# Lock files
pubspec.lock

# Production environment values.
# `env.dev` and `env.stg` are committed deliberately — they hold no secrets
# and a fresh clone must build. `env.prod` is the one the setup guide tells
# you to create yourself, so it must never be committable.
env.prod

# Firebase configuration
firebase.json
google-services.json
**/google-services.json
