# Gemfile for running fastlane from apps/mobile/.
# Keep the gem list identical to the root Gemfile (used when running from the
# repository root). Plugins are listed only in fastlane/Pluginfile.

source "https://rubygems.org"

gem "fastlane"
gem "cocoapods"

plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
