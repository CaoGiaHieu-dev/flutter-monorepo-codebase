# Root fastlane entry point — lets `bundle exec fastlane <lane>` run from the
# repository root. It only imports the real lanes from apps/mobile/fastlane/.
#
# There is deliberately no `Dir.chdir` here. fastlane parses a Fastfile inside
# its own chdir block and restores the directory afterwards, so a chdir in this
# file was undone before any lane ran (and Ruby warned "conflicting chdir
# during another chdir block"). The modules resolve every path from their own
# location instead (FASTLANE_DIR / APP_DIR in helpers.rb), so the working
# directory does not matter.

# fastlane reads every imported file and the files the lanes open (pubspec.yaml,
# Config.yaml) in the locale's encoding. Under a C/POSIX locale (a bare Linux
# container, some CI images) that is US-ASCII, and the first non-ASCII byte is
# a SyntaxError or "invalid byte sequence in US-ASCII". Pin UTF-8 before any
# import so the lanes do not depend on LANG / LC_ALL.
Encoding.default_external = Encoding::UTF_8

# fastlane rewrites README.md in the fastlane folder after every run. The one in
# apps/mobile/fastlane/ is hand-written; one here would be an untracked stray.
ENV['FASTLANE_SKIP_DOCS'] = '1'

import "../apps/mobile/fastlane/modules/helpers.rb"
import "../apps/mobile/fastlane/modules/ios_lanes.rb"
import "../apps/mobile/fastlane/modules/android_lanes.rb"
import "../apps/mobile/fastlane/modules/flutter_lanes.rb"
