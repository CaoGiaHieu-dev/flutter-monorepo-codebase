name: {{moduleName}}
description: "A new Flutter package."
version: 0.0.1
publish_to: 'none'

resolution: workspace

environment:
  sdk: "{{{sdkConstraint}}}"
  flutter: "{{{flutterConstraint}}}"

dependencies:
{{^isDomain}}
  flutter:
    sdk: flutter
{{/isDomain}}

  # internal packages
  #
  # Generated by PubspecGenerator, which locates each package by NAME and
  # computes the relative path. Nothing here is hardcoded, so moving packages
  # around does not break the generator.
{{{internalDependencies}}}

  # external packages
  injectable:
  get_it:
{{^isDomain}}
  flutter_localizations:
    sdk: flutter
  intl:
{{/isDomain}}
{{#isFeature}}
  go_router:
  material_ui:
{{/isFeature}}
{{#usesFreezed}}
  freezed_annotation:
  json_annotation:
{{/usesFreezed}}

dev_dependencies:
{{^isDomain}}
  flutter_test:
    sdk: flutter
{{/isDomain}}

  build_runner:
  injectable_generator:
  flutter_lints:
{{#usesFreezed}}
  freezed:
  json_serializable:
{{/usesFreezed}}
{{#isFeature}}
  go_router_builder:
{{/isFeature}}

{{#isFeature}}
flutter:
  generate: true
{{/isFeature}}