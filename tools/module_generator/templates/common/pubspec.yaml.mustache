name: {{moduleName}}
description: "A new Flutter package."
version: 0.0.1
publish_to: 'none'

resolution: workspace

environment:
  sdk: "{{{sdkConstraint}}}"
  flutter: "{{{flutterConstraint}}}"

dependencies:
{{^isDomain}}
  flutter:
    sdk: flutter
{{/isDomain}}

  # internal packages
  #
  # Generated by PubspecGenerator, which locates each package by NAME and
  # computes the relative path. Nothing here is hardcoded, so moving packages
  # around does not break the generator.
{{{internalDependencies}}}

  # external packages — only what the generated files import, so the new
  # package passes check_unused_packages. Add json_annotation (with
  # json_serializable) when the first model needs fromJson.
  injectable:
{{#isFeature}}
  # gen-l10n output (lib/src/gen/language) imports both.
  flutter_localizations:
    sdk: flutter
  intl:
  go_router:
  material_ui:
{{/isFeature}}
{{#usesFreezed}}
  freezed_annotation:
{{/usesFreezed}}

dev_dependencies:
{{^isDomain}}
  flutter_test:
    sdk: flutter
{{/isDomain}}

  build_runner:
  injectable_generator:
  flutter_lints:
{{#usesFreezed}}
  freezed:
{{/usesFreezed}}
{{#isFeature}}
  go_router_builder:
{{/isFeature}}

{{#isFeature}}
flutter:
  generate: true
  # The templates use `Icons` (a nav destination's icon) and depend on
  # core_base_ui, which sets it too — without it `flutter test` warns that the
  # primary pubspec has `uses-material-design: false`.
  uses-material-design: true
{{/isFeature}}