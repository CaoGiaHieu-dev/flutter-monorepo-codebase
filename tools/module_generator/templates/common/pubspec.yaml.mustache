name: {{moduleName}}
description: "A new Flutter package."
version: 0.0.1
publish_to: 'none'

resolution: workspace

environment:
  sdk: '>=3.13.3 <4.0.0'
  flutter: '>=3.47.0'

dependencies:
{{^isDomain}}
  flutter:
    sdk: flutter
{{/isDomain}}

  # internal packages
  #
  # Generated by PubspecGenerator, which locates each package by NAME and
  # computes the relative path. Nothing here is hardcoded, so moving packages
  # around does not break the generator.
{{{internalDependencies}}}

  # external packages
  injectable:
  get_it:
{{^isDomain}}
  flutter_localizations:
    sdk: flutter
  intl:
{{/isDomain}}
{{#isFeature}}
  go_router:
{{/isFeature}}
{{#usesFreezed}}
  freezed_annotation:
  json_annotation:
{{/usesFreezed}}

dev_dependencies:
{{^isDomain}}
  flutter_test:
    sdk: flutter
{{/isDomain}}

  build_runner:
  injectable_generator:
  flutter_lints:
{{#usesFreezed}}
  freezed:
  json_serializable:
{{/usesFreezed}}
{{#isFeature}}
  go_router_builder:
{{/isFeature}}

{{#isFeature}}
flutter:
  generate: true
{{/isFeature}}