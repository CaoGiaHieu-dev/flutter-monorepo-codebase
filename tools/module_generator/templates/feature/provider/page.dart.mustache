import 'package:core_base_ui/core_base_ui.dart';
import 'package:core_responsive/core_responsive.dart';
import 'package:material_ui/material_ui.dart';
import 'package:provider_state_management/provider_state_management.dart';

import '../extensions/l10n_{{snakeNameInput}}_extension.dart';
import '../provider/{{snakeNameInput}}_provider.dart';

class {{pascalNameInput}}Page extends StatelessWidget {
  const {{pascalNameInput}}Page({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(context.l10n{{pascalNameInput}}.title),
      ),
      body: BaseViewWidget<{{pascalNameInput}}Provider, Object>(
        // Without this a failed first load renders nothing at all: the error
        // path falls back to the success / empty builder. `message` is an
        // English diagnostic and is never shown (RULE-34); the user reads a
        // translated sentence. To word a failure by its code, carry the code
        // in a feature error state (see AuthErrorState) and pick the sentence
        // with `context.l10n.failureMessage(code)`.
        onErrorBuilder: (context, data, message, child) =>
            Center(child: Text(context.l10n.somethingWentWrong)),
        builder: (context, data, child) {
          // AdaptiveContent (core_responsive) caps the column at a readable
          // width on a tablet or desktop window and changes nothing on a
          // phone. Sizes and type come from the design system, already
          // scaled through context — never a raw number, and never re-scaled
          // (RULE-30, RULE-31).
          return AdaptiveContent(
            padding: EdgeInsets.all(AppSpacing.lg(context)),
            child: Text(
              context.l10n{{pascalNameInput}}.title,
              style: AppTextStyles.bodyMediumStyle(context),
            ),
          );
        },
      ),
    );
  }
}
