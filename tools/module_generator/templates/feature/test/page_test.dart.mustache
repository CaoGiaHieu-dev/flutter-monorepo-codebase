/// A [{{pascalNameInput}}Provider] whose first load fails with a diagnostic
/// that must never reach the screen.
class _FailingProvider extends {{pascalNameInput}}Provider {
  static const diagnostic = 'HTTP 500: upstream stack trace';

  @override
  Future<void> initialize() async {
    await super.initialize();
    await executeOperation(
      OperationConfig(
        operation: () async => const Result<Object>.failure(
          ServerFailure(message: diagnostic, code: 500),
        ),
      ),
    );
  }
}
{{/isProvider}}

void main() {
  testWidgets('shows its localized title in the app bar and the body', (
    tester,
  ) async {
    await _pumpPage(tester);

    final title = {{pascalName}}Localizations.of(
      tester.element(find.byType({{pascalNameInput}}Page)),
    )!.title;
    expect(
      find.descendant(of: find.byType(AppBar), matching: find.text(title)),
      findsOneWidget,
    );
    expect(find.text(title), findsNWidgets(2));
  });

  testWidgets('lays out on a phone and on a tablet', (tester) async {
    addTearDown(tester.view.reset);
    for (final size in const [Size(360, 740), Size(1280, 800)]) {
      tester.view
        ..physicalSize = size
        ..devicePixelRatio = 1;
      await _pumpPage(tester);
      expect(tester.takeException(), isNull);
      expect(find.byType({{pascalNameInput}}Page), findsOneWidget);
    }
  });
{{#isProvider}}

  testWidgets('a failed first load shows a translated sentence, not the '
      'diagnostic', (tester) async {
    await _pumpApp(
      tester,
      // Typed as the page's provider: `BaseViewWidget` looks that type up.
      ChangeNotifierProvider<{{pascalNameInput}}Provider>(
        create: (_) => _FailingProvider(),
        child: const {{pascalNameInput}}Page(),
      ),
    );

    final sentence = AppLocalizations.of(
      tester.element(find.byType({{pascalNameInput}}Page)),
    )!.somethingWentWrong;
    expect(find.text(sentence), findsOneWidget);
    expect(find.text(_FailingProvider.diagnostic), findsNothing);
  });
{{/isProvider}}
}
