/// Pumps [home] the way the app shows a page: under `ResponsiveInit` (every
/// size in the page goes through `context`, and `ResponsiveScope.of` asserts
/// without it), the palette's theme extension, the app-wide strings
/// (`context.l10n`) and this feature's localizations.
Future<void> _pumpApp(WidgetTester tester, Widget home) async {
  await tester.pumpWidget(
    MaterialApp(
      // Widgets read palette tokens through `context.colors`.
      theme: ThemeData(extensions: [ThemeSystemExtension.light]),
      localizationsDelegates: [
        ...AppLocalizations.localizationsDelegates,
        ...{{pascalName}}Localizations.localizationsDelegates,
      ],
      supportedLocales: {{pascalName}}Localizations.supportedLocales,
      builder: (context, child) => ResponsiveInit(child: child!),
      home: home,
    ),
  );
  await tester.pumpAndSettle();
}

/// Pumps [{{pascalNameInput}}Page] the way the app shows it{{^isNone}}, its
/// controller provided above it exactly as `{{pascalNameInput}}Route.build`
/// does — the page never creates its own{{/isNone}}.
///
/// Generated by tools/module_generator. Replace the real controller with a
/// fake once it has dependencies, and keep the test when the page grows.
Future<void> _pumpPage(WidgetTester tester) {
  return _pumpApp(
    tester,
