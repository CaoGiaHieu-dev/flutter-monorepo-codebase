/// Pumps [{{pascalNameInput}}Page] the way the app shows it: under
/// `ResponsiveInit` (every size in the page goes through `context`, and
/// `ResponsiveScope.of` asserts without it) and with this feature's
/// localizations{{^isNone}}, its controller provided above it exactly as
/// `{{pascalNameInput}}Route.build` does — the page never creates its own{{/isNone}}.
///
/// Generated by tools/module_generator. Replace the real controller with a
/// fake once it has dependencies, and keep the test when the page grows.
Future<void> _pumpPage(WidgetTester tester) async {
  await tester.pumpWidget(
    MaterialApp(
      localizationsDelegates:
          {{pascalName}}Localizations.localizationsDelegates,
      supportedLocales: {{pascalName}}Localizations.supportedLocales,
      builder: (context, child) => ResponsiveInit(child: child!),
{{#isProvider}}
      home: ChangeNotifierProvider(
        create: (_) => {{pascalNameInput}}Provider(),
        child: const {{pascalNameInput}}Page(),
      ),
{{/isProvider}}
{{#isBloc}}
      home: BlocProvider(
        create: (_) =>
            {{pascalNameInput}}Bloc()..add(const {{pascalNameInput}}Event.started()),
        child: const {{pascalNameInput}}Page(),
      ),
{{/isBloc}}
{{#isNone}}
      home: const {{pascalNameInput}}Page(),
{{/isNone}}
    ),
  );
  await tester.pumpAndSettle();
}

void main() {
  testWidgets('shows its localized title in the app bar and the body', (
    tester,
  ) async {
    await _pumpPage(tester);

    final title = {{pascalName}}Localizations.of(
      tester.element(find.byType({{pascalNameInput}}Page)),
    )!.title;
    expect(
      find.descendant(of: find.byType(AppBar), matching: find.text(title)),
      findsOneWidget,
    );
    expect(find.text(title), findsNWidgets(2));
  });

  testWidgets('lays out on a phone and on a tablet', (tester) async {
    addTearDown(tester.view.reset);
    for (final size in const [Size(360, 740), Size(1280, 800)]) {
      tester.view
        ..physicalSize = size
        ..devicePixelRatio = 1;
      await _pumpPage(tester);
      expect(tester.takeException(), isNull);
      expect(find.byType({{pascalNameInput}}Page), findsOneWidget);
    }
  });
}
